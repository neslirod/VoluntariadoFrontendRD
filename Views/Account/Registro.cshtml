@model VoluntariosConectadosRD.Models.RegistroViewModel
@{
    ViewData["Title"] = "Registro de Voluntario - Voluntariado Conectado RD";
}

<div class="register-bg d-flex align-items-center justify-content-center" style="min-height:100vh; background: linear-gradient(135deg, #0d6efd 0%, #dc3545 100%);">
    <div class="register-card card shadow-lg p-4" style="max-width: 500px; border-radius: 18px; margin-bottom:40px; margin-top: 140px;">
        <div class="mb-4 text-center">
            <div class="fw-bold text-uppercase" style="font-size: 0.9rem; margin-top: -0.5rem;">¡ÚNETE A NOSOTROS!</div>
        </div>
        <form asp-action="Registro" method="post" autocomplete="off">
            <div class="row mb-3">
                <div class="col">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" type="text" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="col">
                    <label asp-for="Apellidos" class="form-label"></label>
                    <input asp-for="Apellidos" class="form-control" type="text" />
                    <span asp-validation-for="Apellidos" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-3">
                <div class="col">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" type="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col">
                    <label asp-for="Telefono" class="form-label"></label>
                    <input asp-for="Telefono" class="form-control" type="text" />
                    <span asp-validation-for="Telefono" class="text-danger"></span>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col">
                    <label asp-for="Password" class="form-label">Contraseña</label>
                    <input asp-for="Password" class="form-control" type="password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="col">
                    <label asp-for="Confirmar" class="form-label">Confirmar Contraseña</label>
                    <input asp-for="Confirmar" class="form-control" type="password" />
                    <span asp-validation-for="Confirmar" class="text-danger"></span>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col">
                    <label asp-for="Fecha" class="form-label"></label>
                    <input asp-for="Fecha" class="form-control" type="date" />
                    <span asp-validation-for="Fecha" class="text-danger"></span>
                </div>
                <div class="col">
                    <label asp-for="Provincia" class="form-label"></label>
                    <input asp-for="Provincia" class="form-control" type="text" />
                    <span asp-validation-for="Provincia" class="text-danger"></span>
                </div>
            </div>
            <div class="form-check mb-3">
                <input type="hidden" asp-for="Terminos" />
                <input asp-for="Terminos" class="form-check-input" type="checkbox" id="Terminos" />
                <label asp-for="Terminos" class="form-check-label" for="Terminos">
                    Acepto los <a href="/Home/Privacy" target="_blank">términos y condiciones</a> y la <a href="/Home/Privacy" target="_blank">política de privacidad</a>.
                </label>
                <span asp-validation-for="Terminos" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100 mb-2">Registrarme</button>
            <button type="button" class="btn btn-outline-secondary w-100 mb-2" onclick="location.href='/signin-google'">
                <img src="https://developers.google.com/identity/images/g-logo.png" alt="Google" style="width:20px; margin-right:8px;"> Registrarme con Google
            </button>
            <div class="text-center mt-2">
                <span class="text-muted">¿Ya tienes cuenta?</span> <a href="/Account/Login">Inicia sesión aquí</a>
            </div>
        </form>
        @section Scripts {
            @await Html.PartialAsync("_ValidationScriptsPartial")
        }
    </div>
</div>
