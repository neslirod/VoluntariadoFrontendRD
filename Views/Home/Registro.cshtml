@{
    ViewData["Title"] = "Registro de Voluntario - Voluntariado Conectado RD";
}

<div class="register-bg d-flex align-items-center justify-content-center" style="min-height:100vh; background: linear-gradient(135deg, #0d6efd 0%, #dc3545 100%);">
    <div class="register-card card shadow-lg p-4" style="max-width: 500px; border-radius: 18px; margin-bottom:40px; margin-top: 140px;">
        <div class="mb-4 text-center">
            <div class="fw-bold text-uppercase" style="font-size: 0.9rem; margin-top: -0.5rem;">¡ÚNETE A NOSOTROS!</div>
        </div>
        <form method="post" autocomplete="off">
            <div class="row mb-3">
                <div class="col">
                    <label for="nombre" class="form-label">Nombre</label>
                    <input type="text" class="form-control" id="nombre" name="nombre" placeholder="Ingresa tu nombre" required />
                </div>
                <div class="col">
                    <label for="apellidos" class="form-label">Apellidos</label>
                    <input type="text" class="form-control" id="apellidos" name="apellidos" placeholder="Ingresa tus apellidos" required />
                </div>
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">Correo electrónico</label>
                <input type="email" class="form-control" id="email" name="email" placeholder="Ingresa tu correo" required />
            </div>
            <div class="row mb-3">
                <div class="col">
                    <label for="password" class="form-label">Contraseña</label>
                    <input type="password" class="form-control" id="password" name="password" placeholder="Contraseña" required />
                </div>
                <div class="col">
                    <label for="confirmar" class="form-label">Confirmar Contraseña</label>
                    <input type="password" class="form-control" id="confirmar" name="confirmar" placeholder="Repite la contraseña" required />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col">
                    <label for="fecha" class="form-label">Fecha de nacimiento</label>
                    <input type="date" class="form-control" id="fecha" name="fecha" required />
                </div>
                <div class="col">
                    <label for="provincia" class="form-label">Provincia de Residencia</label>
                    <input type="text" class="form-control" id="provincia" name="provincia" placeholder="Provincia" required />
                </div>
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="terminos" name="terminos" required />
                <label class="form-check-label" for="terminos">
                    Acepto los <a href="/Home/Privacy" target="_blank">términos y condiciones</a> y la <a href="/Home/Privacy" target="_blank">política de privacidad</a>.
                </label>
            </div>
            <button type="submit" class="btn btn-primary w-100 mb-2" href="/Home/RegistroExito">Registrarme</button>
            <button type="button" class="btn btn-outline-secondary w-100 mb-2" onclick="location.href='/signin-google'">
                <img src="https://developers.google.com/identity/images/g-logo.png" alt="Google" style="width:20px; margin-right:8px;"> Registrarme con Google
            </button>
            <div class="text-center mt-2">
                <span class="text-muted">¿Ya tienes cuenta?</span> <a href="/Home/Login">Inicia sesión aquí</a>
            </div>
        </form>
    </div>
</div>