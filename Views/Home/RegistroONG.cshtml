@{
    ViewData["Title"] = "Registro de ONG - Voluntariado Conectado RD";
}

<div class="register-bg d-flex align-items-center justify-content-center" style="min-height:100vh; background: linear-gradient(135deg, #0d6efd 0%, #dc3545 100%);">
    <div class="register-card card shadow-lg p-4" style="max-width: 540px; border-radius: 18px; margin-bottom:40px; margin-top: 140px;">
        <div class="mb-4 text-center">
            <div class="fw-bold text-uppercase" style="font-size: 0.9rem; margin-top: -0.5rem;">¡ÚNETE A NOSOTROS!</div>
        </div>
        <form method="post" autocomplete="off" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="nombreONG" class="form-label">Nombre de la ONG</label>
                <input type="text" class="form-control" id="nombreONG" name="nombreONG" placeholder="Ingresa el nombre de la ONG" required />
            </div>
            <div class="row mb-3">
                <div class="col">
                    <label for="rnc" class="form-label">RNC o Identificación Legal</label>
                    <input type="text" class="form-control" id="rnc" name="rnc" placeholder="RNC o ID legal" required />
                </div>
                <div class="col">
                    <label for="telefono" class="form-label">Teléfono de contacto</label>
                    <input type="tel" class="form-control" id="telefono" name="telefono" placeholder="Teléfono" required />
                </div>
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">Correo institucional</label>
                <input type="email" class="form-control" id="email" name="email" placeholder="Correo institucional" required />
            </div>
            <div class="row mb-3">
                <div class="col">
                    <label for="password" class="form-label">Contraseña</label>
                    <input type="password" class="form-control" id="password" name="password" placeholder="Contraseña" required />
                </div>
                <div class="col">
                    <label for="representante" class="form-label">Representante legal</label>
                    <input type="text" class="form-control" id="representante" name="representante" placeholder="Nombre representante" required />
                </div>
            </div>
            <div class="mb-3">
                <label for="logoONG" class="form-label">Logo de la organización</label>
                <input type="file" class="form-control" id="logoONG" name="logoONG" accept="image/*" />
            </div>
            <div class="mb-3">
                <label for="descripcion" class="form-label">Descripción / Misión</label>
                <textarea class="form-control" id="descripcion" name="descripcion" rows="2" placeholder="Describe la misión de la ONG" required></textarea>
            </div>
            <div class="mb-3">
                <label for="sector" class="form-label">Sector</label>
                <select class="form-select" id="sector" name="sector" required>
                    <option value="">Selecciona un sector</option>
                    <option>Educación</option>
                    <option>Salud</option>
                    <option>Medio ambiente</option>
                    <option>Desarrollo social</option>
                    <option>Otro</option>
                </select>
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="terminos" name="terminos" required />
                <label class="form-check-label" for="terminos">
                    Acepto los <a href="/Home/Privacy" target="_blank">términos y condiciones</a> y la <a href="/Home/Privacy" target="_blank">política de privacidad</a>.
                </label>
            </div>
            <button type="submit" class="btn btn-primary w-100 mb-2" href="/Home/RegistroExito">Enviar</button>
            <button type="button" class="btn btn-outline-secondary w-100 mb-2" onclick="location.href='/signin-google'">
                <img src="https://developers.google.com/identity/images/g-logo.png" alt="Google" style="width:20px; margin-right:8px;"> Registrarme con Google
            </button>
            <div class="text-center mt-2">
                <span class="text-muted">¿Ya tienes cuenta?</span> <a href="/Home/Login">Inicia sesión aquí</a>
            </div>
        </form>
    </div>
</div>
